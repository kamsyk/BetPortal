{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "DatabaseLogging": {
    "Enabled": true,
    "MinimumLevel": "Warning",
    "TableName": "BpAppLogs",
    "BatchPeriodSeconds": 5
  },
  "AllowedHosts": "*",
  "ClaudeChatService": {
    "BaseUrl": "http://localhost:8000",
    "Model": "claude-haiku-4-5",
    "MaxTokens": "1024",
    "TimeoutSeconds": "120"
  }
}
